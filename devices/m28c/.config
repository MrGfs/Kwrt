CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_widora_mangopi-m28c=y

# ===== QModem (4G/5G 模组管理 + 实时天线信号 antenna_signal) =====
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-mhi-pci-generic=y
CONFIG_PACKAGE_proto-qmi=y
CONFIG_PACKAGE_proto-mbim=y

# ===== AIC8800 SDIO WiFi 6（M28C 板载，SDIO ID C8A1:0082 / C8A1:0182）=====
# 基线 ImmortalWrt openwrt-25.12 自带 package/kernel/aic8800，无需额外 feed。
# 不选时：SDIO 卡能枚举但没有驱动绑定，无 /sys/class/ieee80211、无 wlan0、无 /etc/config/wireless。
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
# common/.config 里 wifi-scripts=m（只出 ipk 不进镜像），这里覆盖为 =y，否则固件里没有 /sbin/wifi。
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
