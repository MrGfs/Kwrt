        { "pkg": "kmod-usb-serial-ch341",     "desc": "CH341 串口驱动", "default": true },
        { "pkg": "kmod-mhi-pci-generic",      "desc": "MHI PCI 驱动（RM520N 等 PCIe 模组必需）", "default": true },
        { "pkg": "proto-qmi",                  "desc": "QMI 网络协议支持", "default": true },
        { "pkg": "proto-mbim",                 "desc": "MBIM 网络协议支持", "default": true }
      ]
    },
