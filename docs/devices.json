  "groups": [
    {
      "id": "system",
      "title": "系统基础工具（强制包含，不可取消）",
      "desc": "编译后必定存在的基础运行环境，锁定不可取消。",
      "packages": [
        { "pkg": "bash",                       "desc": "Bourne-Again Shell，完整 shell 环境", "default": true, "locked": true },
        { "pkg": "curl",                       "desc": "命令行 HTTP 客户端，下载/API 调试", "default": true, "locked": true },
